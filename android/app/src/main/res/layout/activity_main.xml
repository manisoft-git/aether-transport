<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_aether_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vpn_title"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/vpn_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Network Mode Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:background="@drawable/card_bg"
            android:padding="4dp">

            <Button
                android:id="@+id/btn_mode_best"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="⚡ BEST NETWORK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg" />

            <Button
                android:id="@+id/btn_mode_turbo"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="🛡️ SOVEREIGN FEC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- 1-Click Power Button -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="18dp">

            <Button
                android:id="@+id/btn_toggle_vpn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/btn_circle_idle"
                android:text="@string/btn_activate"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:elevation="6dp" />
        </FrameLayout>

        <!-- Status Indicator -->
        <TextView
            android:id="@+id/tv_vpn_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_standby"
            android:textColor="@color/cyan_glow"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <!-- Protocol Metrics Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ REAL-TIME NETWORK HUD &amp; TELEMETRY"
                android:textColor="@color/cyan_glow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DNS LATENCY"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_dns_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24.5 ms"
                        android:textColor="@color/emerald_glow"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_dns_gain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ 3.8x Speedup"
                        android:textColor="@color/cyan_glow"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOSS TOLERANCE"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_loss_tolerance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Up to 45%"
                        android:textColor="@color/emerald_glow"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GF(2^8) Reed-Solomon"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUERIES ACCELERATED"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                    <TextView
                        android:id="@+id/tv_queries_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 queries"
                        android:textColor="@color/text_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MTU CLAMPING"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1400 Bytes"
                        android:textColor="@color/amber_alert"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </GridLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/border_subtle" />

            <TextView
                android:id="@+id/tv_uptime_telemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uptime: 00:00:00 • Zero-RTT Recovery: Standby"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Live Network Speed & Latency Audit Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 REAL-TIME ANYCAST ROUTE BENCHMARK"
                android:textColor="@color/cyan_glow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/audit_hint"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_run_audit"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_run_audit"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/card_bg" />

            <TextView
                android:id="@+id/tv_audit_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Cloudflare 1.1.1.1: Ready\n• Google 8.8.8.8: Ready\n• Quad9 9.9.9.9: Ready"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Operator Identity Card (Protocol Standard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPERATOR CREDENTIALS (PROTOCOL VERIFIED)"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tobi Olive (@tobiolive5850)"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="tobi585olive@gmail.com"
                android:textColor="@color/cyan_glow"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
